## Do not remove these
test/assets/
test/assets/*

# Rust
target/
**/target/
*.pdb

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tauri build output
desktop/src-tauri/gen/
desktop/src-tauri/target/

# Python (tooling and one-off scripts live at the repo root for now)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Scratch media at the repo root.
#
# Test clips are large and change constantly, so they do not belong in git
# history. Fixtures that tests genuinely depend on should live in a `fixtures/`
# directory next to those tests and be committed deliberately - this pattern
# only covers loose files dropped at the top level.
/*.mp4
/*.mov
/*.mkv
/*.webm
/*.mp3
/*.wav
/*.flac
/*.aac
/scratch_*

# Local environment
.env
.env.local

# FFmpeg development build for the FFI decoder (headers + import libs).
# Large, machine-specific, and not needed for a normal build - see BUILD.md.
/vendor/

# Bundled FFmpeg, staged for packaging. Produced by .github/workflows/ffmpeg.yml
# or copied from a dev build - either way it is a binary artifact, not source.
# The README stays tracked so the directory exists on a fresh checkout - the
# `ffmpeg/*` resources glob in tauri.conf.json fails the build if it matches
# nothing.
desktop/src-tauri/ffmpeg/*
!desktop/src-tauri/ffmpeg/README.md
